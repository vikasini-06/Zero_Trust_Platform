# Environment Mode
NODE_ENV=production
PORT=5000

# MongoDB Database Connection (MongoDB Atlas Connection String)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/zerotrust?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-url>/zerotrust?retryWrites=true&w=majority

# JSON Web Token Secret & Expiry
JWT_SECRET=your_super_secret_jwt_key_min_32_characters
JWT_EXPIRES_IN=24h

# Allowed Frontend Origins (Comma-separated for multiple origins)
FRONTEND_URL=https://<your-frontend-static-site>.onrender.com
CLIENT_URL=https://<your-frontend-static-site>.onrender.com

# SMTP Credentials (Optional - for Email alerts and recovery tokens)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
